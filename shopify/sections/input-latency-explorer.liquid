{% assign latency_asset_revision = '20261113-2030' %}
{% assign latency_css_revision = '20261113-2030' %}
{% capture latency_data_asset %}input-latency-data-{{ latency_asset_revision }}.js{% endcapture %}
{% capture latency_css_asset %}input-latency-explorer-{{ latency_css_revision }}.css{% endcapture %}
{% capture latency_js_asset %}input-latency-explorer-{{ latency_asset_revision }}.js{% endcapture %}
{% assign latency_data_url = latency_data_asset | asset_url %}
{% assign latency_css_url = latency_css_asset | asset_url %}
{% assign latency_js_url = latency_js_asset | asset_url %}
{% assign core_link_url = section.settings.core_link_url %}
{% if core_link_url == blank or core_link_url == '/pages/mister-core-explorer' %}
  {% assign core_link_url = '/pages/cores' %}
{% endif %}
{{ latency_css_url | stylesheet_tag }}
<script src="{{ latency_data_url }}" defer></script>
<script src="{{ latency_js_url }}" defer></script>

<!-- Input latency explorer shell revision: service-menu-20261113-2030. -->
<section class="input-latency-explorer-app" data-reflex-theme-scope data-reflex-theme="midnight" data-latency-url="{{ section.settings.latency_url | escape }}">
  <script>
    (function (scope) {
      // Same names as the toggle script after the section; set here so the first paint is right.
      var themes = { midnight: ['midnight', 'midnight-light'], amber: ['amber', 'amber-light'], reflex: ['reflex', 'reflex-light'], green: ['', 'lab'], white: ['white', 'white-light'] };
      var colour = 'midnight';
      var light = false;
      try {
        colour = localStorage.getItem('reflex-svc-colour') || 'midnight';
        var saved = localStorage.getItem('reflex-theme');
        light = saved === 'lab' || saved === 'light';
      } catch (error) {
      }
      if (!Object.prototype.hasOwnProperty.call(themes, colour)) colour = 'midnight';
      var name = themes[colour][light ? 1 : 0];
      if (name) scope.setAttribute('data-reflex-theme', name);
      else scope.removeAttribute('data-reflex-theme');
    })(document.currentScript.parentElement);
  </script>
  <div class="svc latency-svc"{% if section.settings.show_bezel %} data-svc-bezel="on"{% endif %}>
    <div class="svc-frame"><div class="svc-screen">
      <div>
        <header class="svc-top">
          <div class="svc-wordmark"><h1>Latency</h1><span>Input latency explorer</span></div>
          <div class="svc-row">
            <select id="latencyThemeColour" class="latency-theme" aria-label="Theme colour">
              <option value="midnight">Theme: Midnight</option>
              <option value="amber">Theme: Amber</option>
              <option value="reflex">Theme: Reflex</option>
              <option value="green">Theme: Green</option>
              <option value="white">Theme: White</option>
            </select>
            <button type="button" id="latencyThemeToggle" data-reflex-theme-option="lab">Light</button>
            <a class="latency-action" href="https://docs.google.com/spreadsheets/d/1KlRObr3Be4zLch7Zyqg6qCJzGuhyGmXaOIUrpfncXIM/edit?gid=0#gid=0" target="_blank" rel="noreferrer noopener">Source Sheet</a>
            <a class="latency-action svc-primary" href="{{ core_link_url }}">Core Explorer</a>
          </div>
        </header>
        <div class="svc-ident">
          <strong>{{ section.settings.title }}</strong>
          <span id="latencyIdentCount">Loading</span>
          <span>Best: <strong id="latencyIdentBest">-</strong></span>
          <span>Median: <span id="latencyIdentMedian">-</span></span>
          <span>Updated: <span id="latencyIdentUpdated">-</span></span>
          <span>Amazon links are affiliate links</span>
        </div>
      </div>

      <div class="svc-body">
        <nav class="svc-menu" id="latencyMenu" role="tablist" aria-orientation="vertical" aria-label="Latency menu">
          <button type="button" role="tab" id="latencyTabRanking" aria-controls="latencyPageRanking" aria-selected="true" data-page="latencyPageRanking">Ranking</button>
          <button type="button" role="tab" id="latencyTabMap" aria-controls="latencyPageMap" aria-selected="false" data-page="latencyPageMap" tabindex="-1">Latency Map</button>
          <button type="button" role="tab" id="latencyTabRecent" aria-controls="latencyPageRecent" aria-selected="false" data-page="latencyPageRecent" tabindex="-1">Recent</button>
          <button type="button" role="tab" id="latencyTabBest" aria-controls="latencyPageBest" aria-selected="false" data-page="latencyPageBest" tabindex="-1">Best by Category</button>
          <button type="button" role="tab" id="latencyTabMethod" aria-controls="latencyPageMethod" aria-selected="false" data-page="latencyPageMethod" tabindex="-1">Methodology</button>
        </nav>

        <section class="svc-page" id="latencyPageRanking" role="tabpanel" aria-labelledby="latencyTabRanking">
          <div class="svc-title"><h2>Ranking</h2><span class="svc-meta" id="latencyCount">-</span></div>
          <div class="svc-toolbar">
            <div class="svc-search">
              <input id="latencySearchInput" type="search" placeholder="Search devices, makers, tiers" aria-label="Search devices">
              <select id="latencySortSelect" aria-label="Sort">
                <option value="average">Sort: Average latency</option>
                <option value="same-frame">Sort: Same-frame chance</option>
                <option value="name">Sort: Name</option>
                <option value="date-added">Sort: Date added</option>
              </select>
              <button type="button" id="latencySortDirectionToggle" aria-label="Reverse the sort order">Asc &#9652;</button>
            </div>
            <div class="svc-filters">
              <label><span>Category</span><select id="latencyCategorySelect"><option value="">All categories</option></select></label>
              <label><span>Connection</span><select id="latencyConnectionSelect"><option value="">All connections</option></select></label>
              <label><span>Tier</span><select id="latencyTierSelect"><option value="">All tiers</option></select></label>
              <label><span>Sale status</span><select id="latencySaleStatusSelect"><option value="">All sale statuses</option></select></label>
            </div>
            <details class="svc-advanced" id="latencyMoreFilters">
              <summary>More filters: face buttons, home button, adapter input, output mode, firmware<span class="latency-more-count" id="latencyMoreCount"></span></summary>
              <div class="svc-advanced-body">
                <div class="svc-filters">
                  <label><span>Face buttons</span><select id="latencyFaceButtonsSelect" disabled><option value="">All face buttons</option></select></label>
                  <label><span>Home button</span><select id="latencyHomeButtonSelect" disabled><option value="">Any home button</option></select></label>
                  <label><span>Adapter input</span><select id="latencyAdapterInputSelect" disabled><option value="">All adapter inputs</option></select></label>
                  <label><span>Output mode</span><select id="latencyModeSelect"><option value="">All output modes</option></select></label>
                  <label><span>Firmware</span><select id="latencySourceStatusSelect"><option value="">All firmware</option></select></label>
                </div>
                <p class="svc-help">Face and home button filters apply to controllers and arcade sticks; adapter input applies to controller adapters.</p>
              </div>
            </details>
          </div>
          <p class="latency-status" id="latencyStatusBanner" aria-live="polite" hidden>Loading latency data...</p>
          <div class="svc-tablewrap">
            <table class="svc-table" id="latencyTable">
              <thead><tr><th class="svc-num">#</th><th>Device</th><th class="svc-num">Avg ms</th><th class="svc-hide-sm">Log scale</th><th>Tier</th><th class="svc-hide-md">Link</th><th class="svc-hide-md">Category rank</th></tr></thead>
              <tbody id="latencyRows"></tbody>
            </table>
          </div>
        </section>

        <section class="svc-page" id="latencyPageMap" role="tabpanel" aria-labelledby="latencyTabMap" hidden>
          <div class="svc-title"><h2>Latency Map</h2><span class="svc-meta" id="latencyMapMeta">-</span></div>
          <div class="svc-chart">
            <div class="svc-readout" id="latencyReadout" aria-live="polite">Point at a device</div>
            <svg id="latencyScatter" class="latency-chart" role="img" aria-label="Average latency against same-frame probability"></svg>
            <div id="latencyXPanScrollbar" class="latency-pan" role="region" aria-label="Scan the zoomed latency window" tabindex="0" aria-disabled="true">
              <div id="latencyXPanTrack" class="latency-pan-fill"></div>
            </div>
          </div>
          <div class="svc-field latency-zoom">
            <span>Window</span>
            <div class="svc-rangeline">
              <input id="latencyXZoomSlider" class="svc-range" type="range" min="0" max="100" value="0" step="1" aria-label="Latency window zoom">
              <output id="latencyXZoomLabel" for="latencyXZoomSlider">All</output>
            </div>
          </div>
          <p>Each point is one device. Across: average latency on a log scale. Up: chance the press lands in the same 60 Hz frame, from the average. Points past one frame (16.67 ms) show in the warning colour. Scroll over the map or drag the slider to zoom; nearby points fan out under the pointer, and a click opens the device in Ranking.</p>
          <h3 class="svc-sub">Tiers</h3>
          <div class="svc-leaders svc-leaders-cols" id="latencyTiers"></div>
        </section>

        <section class="svc-page" id="latencyPageRecent" role="tabpanel" aria-labelledby="latencyTabRecent" hidden>
          <div class="svc-title"><h2>Recent</h2><span class="svc-meta" id="latencyRecentMeta">5 newest</span></div>
          <div class="svc-tablewrap">
            <table class="svc-table" id="latencyRecentTable">
              <thead><tr><th>Added</th><th>Device</th><th class="svc-num">Avg ms</th><th>Tier</th><th class="svc-hide-md">Link</th></tr></thead>
              <tbody id="latencyRecentRows"></tbody>
            </table>
          </div>
        </section>

        <section class="svc-page" id="latencyPageBest" role="tabpanel" aria-labelledby="latencyTabBest" hidden>
          <div class="svc-title"><h2>Best by Category</h2><span class="svc-meta">Fastest average in each</span></div>
          <div class="svc-leaders" id="latencyBest"></div>
        </section>

        <section class="svc-page" id="latencyPageMethod" role="tabpanel" aria-labelledby="latencyTabMethod" hidden>
          <div class="svc-title"><h2>Methodology</h2></div>
          <div class="svc-leaders svc-leaders-cols">
            <div class="svc-lead"><span class="svc-label">USB polling</span><span class="svc-value">1 ms</span></div>
            <div class="svc-lead"><span class="svc-label">Theoretical floor</span><span class="svc-value">0.5 ms</span></div>
            <div class="svc-lead"><span class="svc-label">Fastest measured</span><span class="svc-value" id="latencyMethodBest">-</span></div>
            <div class="svc-lead"><span class="svc-label">Raw captures</span><span class="svc-value" id="latencyMethodRaw">-</span></div>
            <div class="svc-lead"><span class="svc-label">Tester core</span><span class="svc-value"><a href="https://github.com/misteraddons/inputlatency/blob/main/test_core/NES_Lag_Tester.rbf" target="_blank" rel="noreferrer noopener">NES_Lag_Tester.rbf</a></span></div>
            <div class="svc-lead"><span class="svc-label">Press driver</span><span class="svc-value">ATmega32U4</span></div>
          </div>
          <p>Each input device is measured on MiSTer at a 1 ms USB polling interval. An ATmega32U4 is wired directly to a button on the controller PCB and presses it at random times by pulling the button line to ground.</p>
          <p>A custom MiSTer NES core raises a User I/O pin when the USB press arrives, and the microcontroller records the time from commanded press to detection. CSV captures are summarized in R: average, distribution, sample count and percentiles where raw captures exist.</p>
          <p>MiSTer was chosen for deterministic FPGA GPIO and a low-latency USB stack; the results apply to any device that polls USB at 1 ms. Tester files, including the NES_Lag_Tester.rbf core, are in the <a href="https://github.com/misteraddons/inputlatency" target="_blank" rel="noreferrer noopener">inputlatency GitHub repository</a>, and the results in the <a href="https://docs.google.com/spreadsheets/d/1KlRObr3Be4zLch7Zyqg6qCJzGuhyGmXaOIUrpfncXIM/edit?gid=0#gid=0" target="_blank" rel="noreferrer noopener">source spreadsheet</a>.</p>
        </section>
      </div>

      <footer class="svc-hint"><span><b>/</b> Search</span><span><b>&uarr; &darr;</b> Page, with the menu focused</span><span><b>Enter</b> Open a row</span></footer>
    </div></div>
  </div>
</section>

<script>
  (function initReflexThemeToggle() {
    // Light stays in reflex-theme (dark/lab), shared with older pages; the colour is
    // reflex-svc-colour, shared with the Core Explorer. Names follow Reflex-CSS docs/service-menu.md.
    var themes = { midnight: ['midnight', 'midnight-light'], amber: ['amber', 'amber-light'], reflex: ['reflex', 'reflex-light'], green: ['', 'lab'], white: ['white', 'white-light'] };
    var scope = document.currentScript.previousElementSibling;
    var toggle = scope.querySelector('[data-reflex-theme-option]');
    var picker = scope.querySelector('#latencyThemeColour');
    var normalizeLight = function (theme) { return theme === 'lab' || theme === 'light' ? 'lab' : 'dark'; };
    var normalizeColour = function (colour) { return Object.prototype.hasOwnProperty.call(themes, colour) ? colour : 'midnight'; };
    var read = function (key) { try { return localStorage.getItem(key); } catch (error) { return null; } };
    var write = function (key, value) { try { localStorage.setItem(key, value); } catch (error) { } };
    var light = normalizeLight(read('reflex-theme'));
    var colour = normalizeColour(read('reflex-svc-colour'));

    function applyTheme() {
      var name = themes[colour][light === 'lab' ? 1 : 0];
      if (name) scope.setAttribute('data-reflex-theme', name);
      else scope.removeAttribute('data-reflex-theme');
      picker.value = colour;
      toggle.setAttribute('data-reflex-theme-option', light === 'lab' ? 'dark' : 'lab');
      toggle.textContent = light === 'lab' ? 'Dark' : 'Light';
      write('reflex-theme', light);
      write('reflex-svc-colour', colour);
    }

    applyTheme();
    toggle.addEventListener('click', function () { light = normalizeLight(toggle.getAttribute('data-reflex-theme-option')); applyTheme(); });
    picker.addEventListener('change', function () { colour = normalizeColour(picker.value); applyTheme(); });
  })();
</script>

{% schema %}
{
  "name": "Input Latency Explorer",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Input Latency Explorer"
    },
    {
      "type": "text",
      "id": "byline",
      "label": "Byline",
      "default": "By Mister Addons"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Browse controller latency measurements - recorded on MiSTer FPGA, but applicable to devices that poll USB at 1 ms."
    },
    {
      "type": "text",
      "id": "core_link_text",
      "label": "Core link text",
      "default": "Looking for core releases instead?"
    },
    {
      "type": "text",
      "id": "core_link_label",
      "label": "Core link label",
      "default": "Open the MiSTer Core Explorer"
    },
    {
      "type": "text",
      "id": "core_link_url",
      "label": "Core explorer URL",
      "default": "/pages/cores"
    },
    {
      "type": "text",
      "id": "latency_url",
      "label": "Latency JSON URL"
    },
    {
      "type": "checkbox",
      "id": "show_bezel",
      "label": "Show the monitor bezel",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Input Latency Explorer"
    }
  ]
}
{% endschema %}
